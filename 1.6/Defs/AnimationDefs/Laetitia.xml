      <li>
        <key>Root</key>
        <value>
          <workerClass>AnimationWorker_Keyframes</workerClass>
          <keyframes>
            <li><tick>0</tick><offset>(0,0,0)</offset></li>
            <li><tick>10</tick><offset>(0,0,0)</offset></li>
            <li><tick>11</tick><offset>(-0.01,0,0.02)</offset></li>
